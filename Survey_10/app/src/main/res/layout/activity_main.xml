<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <!-- Анкета длинная — делаем её прокручиваемой -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/screen_padding">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/title"
                android:textSize="@dimen/text_title"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="@string/hint_name"
                android:inputType="textPersonName" />

            <!-- Возраст: можно выбрать только один вариант -->
            <TextView
                style="@style/SectionTitle"
                android:text="@string/section_age" />

            <RadioGroup
                android:id="@+id/rgAge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rbUnder18"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/age_under18" />

                <RadioButton
                    android:id="@+id/rb18to25"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/age_18_25" />

                <RadioButton
                    android:id="@+id/rbOver25"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/age_over25" />
            </RadioGroup>

            <!-- Интересы: можно отметить несколько -->
            <TextView
                style="@style/SectionTitle"
                android:text="@string/section_interests" />

            <CheckBox
                android:id="@+id/cbSport"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/interest_sport" />

            <CheckBox
                android:id="@+id/cbMusic"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/interest_music" />

            <CheckBox
                android:id="@+id/cbGames"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/interest_games" />

            <CheckBox
                android:id="@+id/cbBooks"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/interest_books" />

            <!-- Город: выпадающий список -->
            <TextView
                style="@style/SectionTitle"
                android:text="@string/section_city" />

            <Spinner
                android:id="@+id/spCity"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:entries="@array/cities" />

            <!-- Переключатель -->
            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/swSubscribe"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/section_margin"
                android:text="@string/subscribe" />

            <Button
                android:id="@+id/btnSend"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/section_margin"
                android:text="@string/btn_send" />

            <TextView
                android:id="@+id/tvSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textSize="16sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/headsCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/heads_count"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tailsCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tails_count"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/rollCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/roll_count"
            android:textSize="22sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/ivCoin"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:paddingTop="12dp"
            android:contentDescription="@string/coin_description"
            android:src="@drawable/heads" />

        <TextView
            android:id="@+id/tvResult"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:gravity="center"
            android:text="@string/press_roll"
            android:textSize="24sp" />

        <Button
            android:id="@+id/btnRoll"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/btn_roll"
            android:textSize="20sp" />
    </LinearLayout>
</LinearLayout>

